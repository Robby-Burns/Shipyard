APP_ENV=development
DEBUG=true
PORT=8000
# Database URL: Supports Neon (PostgreSQL), standard PostgreSQL, or SQLite
# Neon Postgres: postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# SQLite: sqlite+aiosqlite:///./shipyard.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shipyard
OPENROUTER_API_KEY=mock-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CATALOG_URL=
OPENROUTER_PROVIDER_SORT=
INTAKE_SPEC_MAX_TOKENS=3500
INTAKE_SPEC_MAX_CONTINUATIONS=1
GIT_TOKEN=
